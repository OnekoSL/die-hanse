{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Die Hanse",
  "version": "0.1.0",
  "identifier": "com.onekosl.diehanse",
  "build": {
    "beforeDevCommand": "npm.cmd --prefix ../web_ui/frontend run build:desktop",
    "beforeBuildCommand": "npm.cmd --prefix ../web_ui/frontend run build:desktop",
    "frontendDist": "../../web_ui/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Die Hanse",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 650
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "targets": [
      "msi"
    ],
    "resources": {
      "../backend-dist/": "backend-dist/",
      "../../LICENSE": "LICENSE",
      "../../LICENSE-CODE": "LICENSE-CODE",
      "../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../../LICENSE-DOCS": "LICENSE-DOCS"
    }
  }
}
